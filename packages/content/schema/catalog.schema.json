{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lifelong-human-development/schema/catalog.schema.json",
  "title": "Phase Catalog",
  "type": "object",
  "additionalProperties": true,
  "required": ["phases"],
  "properties": {
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "order", "slug", "title", "ageLabel", "primaryObjective", "file"],
        "properties": {
          "id": { "type": "string", "pattern": "^phase-\\d{2}$" },
          "order": { "type": "integer", "minimum": 1 },
          "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "title": { "type": "string" },
          "ageLabel": { "type": "string" },
          "primaryObjective": { "type": "string" },
          "file": { "type": "string" }
        }
      }
    }
  }
}

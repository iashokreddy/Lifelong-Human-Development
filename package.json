{
  "name": "lifelong-human-development",
  "version": "0.1.0",
  "private": true,
  "description": "A platform that supports whole-person development across the entire human lifespan.",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "content:validate": "node tools/pdf/validate-content.mjs",
    "pdf:build": "node tools/pdf/build-pdfs.mjs",
    "test": "npm run content:validate",
    "test:api": "npm --workspace @lhd/api test",
    "dev:api": "npm --workspace @lhd/api run start:dev",
    "dev:web": "npm --workspace @lhd/web run dev",
    "test:web": "npm --workspace @lhd/web test",
    "e2e:web": "npm --workspace @lhd/web run e2e",
    "test:mobile": "npm --workspace @lhd/mobile test",
    "start:mobile": "npm --workspace @lhd/mobile run start"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED"
}

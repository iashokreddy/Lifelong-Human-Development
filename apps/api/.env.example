# Lifelong Human Development API — environment configuration.
# Copy to .env for local development. All values below are optional with safe defaults.

# HTTP port the API listens on. Default: 3001
PORT=3001

# PostgreSQL connection string. When UNSET, the API uses in-memory repositories
# (no database required for build, test, or local exploration). Set this to enable
# the Prisma/Postgres persistence implementation.
# DATABASE_URL=postgresql://user:password@localhost:5432/lhd?schema=public

# Secret used to sign JWTs. A development default is used when unset — NEVER rely
# on the default in production; set a strong secret.
# JWT_SECRET=change-me-in-production

# Optional override for the curriculum content root (packages/content). When unset,
# the API resolves it relative to the repository root, mirroring tools/pdf/lib.mjs.
# LHD_CONTENT_ROOT=
